ARG SERVICE_NAME

FROM maven:3.9.9-eclipse-temurin-17 AS build
ARG SERVICE_NAME
WORKDIR /workspace

COPY pom.xml .
COPY eureka-server/pom.xml eureka-server/pom.xml
COPY config-server/pom.xml config-server/pom.xml
COPY api-gateway/pom.xml api-gateway/pom.xml
COPY auth-service/pom.xml auth-service/pom.xml
COPY delivery-service/pom.xml delivery-service/pom.xml
COPY tracking-service/pom.xml tracking-service/pom.xml
COPY admin-service/pom.xml admin-service/pom.xml
COPY notification-service/pom.xml notification-service/pom.xml

COPY eureka-server/src eureka-server/src
COPY config-server/src config-server/src
COPY api-gateway/src api-gateway/src
COPY auth-service/src auth-service/src
COPY delivery-service/src delivery-service/src
COPY tracking-service/src tracking-service/src
COPY admin-service/src admin-service/src
COPY notification-service/src notification-service/src

RUN mvn -pl ${SERVICE_NAME} -am clean package -DskipTests

FROM eclipse-temurin:17-jre
ARG SERVICE_NAME
WORKDIR /app

COPY --from=build /workspace/${SERVICE_NAME}/target/${SERVICE_NAME}-1.0.0.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
